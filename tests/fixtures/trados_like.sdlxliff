        <trans-unit id="a1d3c6e0-8f8b-4f0e-9a8e-1b2c3d4e5f60">
          <source>Do <g id="pt1">not</g> remove the battery while the device is on. Wait 10 seconds.</source>
          <seg-source><mrk mtype="seg" mid="1">Do <g id="pt1">not</g> remove the battery while the device is on.</mrk> <mrk mtype="seg" mid="2">Wait 10 seconds.</mrk></seg-source>
          <target><mrk mtype="seg" mid="1"><mrk mtype="x-sdl-comment" sdl:cid="3f6b8f1e-5a2c-4d47-9f0e-2c8a1b7d6e54">Извлеките</mrk> <g id="pt1">аккумулятор</g>, пока устройство включено.</mrk> <mrk mtype="seg" mid="2">Подождите <mrk mtype="x-sdl-deleted" sdl:revid="7d1c0a77-3c8e-4b9e-9a51-0b6c1f8e2a10">1</mrk><mrk mtype="x-sdl-added" sdl:revid="8e2d1b88-4d9f-4cad-8b62-1c7d2a9f3b21">10</mrk> секунд.</mrk></target>

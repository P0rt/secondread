        <trans-unit id="b2e4d7f1-9a9c-4a1f-8b9f-2c3d4e5f6a71">
          <source><g id="pt1">Warning:</g> keep away from children under 3.<x id="pt2" />Made in EU.</source>
          <seg-source><g id="pt1"><mrk mtype="seg" mid="3">Warning:</mrk></g> <mrk mtype="seg" mid="4">keep away from children under 3.</mrk><x id="pt2" /><mrk mtype="seg" mid="5">Made in EU.</mrk></seg-source>
          <target><g id="pt1"><mrk mtype="seg" mid="3">Внимание:</mrk></g> <mrk mtype="seg" mid="4">хранить в местах, доступных для детей до 3 лет.</mrk><x id="pt2" /><mrk mtype="seg" mid="5"></mrk></target>
          <sdl:seg-defs>
            <sdl:seg id="3" locked="true" conf="ApprovedSignOff" origin="tm" percent="100" />
